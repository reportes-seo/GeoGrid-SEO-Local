# Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO

# Puppeteer
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=30000

# Tiles del mapa
#
# Sin configurar nada se usa OpenStreetMap oficial (sin clave). Funciona, pero sus
# servidores son de voluntarios y su politica desaconseja el uso comercial
# automatizado: sirve para desarrollo, NO es la opcion buena para produccion.
#
# RECOMENDADO EN PRODUCCION -> CARTO con clave gratuita:
#   1. Pedirla en https://carto.com/basemaps/apikey  (es un FORMULARIO, no la
#      plataforma de pago de CARTO: sin cuenta, sin tarjeta, llega por email al
#      instante). Los precios que aparecen en carto.com son de su producto
#      enterprise de Location Intelligence, que es otra cosa distinta.
#   2. Descomentar las dos lineas de abajo poniendo la clave recibida
#   Limite del tier gratuito: 5.000.000 de tiles/mes, uso comercial permitido.
#   Un informe 9x9 gasta ~40-60 tiles, asi que da para decenas de miles de informes.
#   Es ademas el mismo estilo (Voyager) que ya usaban los informes.
#
# TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=TU_CLAVE_CARTO
# TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>
#
# ALTERNATIVA -> Geoapify (3.000 creditos/dia, ~12.000 tiles/dia):
# TILE_URL=https://maps.geoapify.com/v1/tile/osm-bright/{z}/{x}/{y}.png?apiKey=TU_CLAVE_GEOAPIFY
# TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://www.geoapify.com/">Geoapify</a>
#
# TILE_SUBDOMAINS solo hace falta si la URL lleva {s} (por defecto: abc)

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Defaults
DEFAULT_GRID_SIZE=9
DEFAULT_RADIUS_KM=4.0
DEFAULT_MARKER_SIZE=28
DEFAULT_BRAND_TEXT=EquipoSEO

# Screenshot
DEFAULT_WIDTH=800
DEFAULT_HEIGHT=1100
DEFAULT_FORMAT=png
DEFAULT_QUALITY=90

# Security (API Key Authentication)
API_KEY_ENABLED=true
API_KEYS=your-secret-api-key-min-32-chars-long-here,another-key-if-needed
