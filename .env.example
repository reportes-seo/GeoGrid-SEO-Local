# Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO

# Puppeteer
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=30000

# Tiles del mapa
#
# Lo UNICO que se configura aqui es la clave. La URL del proveedor y la
# atribucion legal del mapa viven en el codigo (utils/tiles.utils.js).
#
#   Con clave  -> CARTO Voyager, sin marca de agua.
#   Sin clave  -> OpenStreetMap oficial (vale para desarrollo, no para produccion).
#
# La clave es GRATIS y se pide en https://carto.com/basemaps/apikey
# Es un formulario: sin cuenta, sin tarjeta, llega por email al instante. No
# confundir con los precios de carto.com, que son de su plataforma enterprise.
# Limite gratuito: 5.000.000 de tiles/mes, uso comercial permitido (~100.000
# informes al mes a 50 tiles por informe).
#
TILE_API_KEY=

# Solo para usar un proveedor distinto de CARTO (Geoapify, MapTiler...): pega la
# plantilla completa con sus {z}/{x}/{y} y tendra prioridad sobre TILE_API_KEY.
# TILE_URL=https://maps.geoapify.com/v1/tile/osm-bright/{z}/{x}/{y}.png?apiKey=TU_CLAVE

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Defaults
DEFAULT_GRID_SIZE=9
DEFAULT_RADIUS_KM=4.0
DEFAULT_MARKER_SIZE=28
DEFAULT_BRAND_TEXT=EquipoSEO

# Screenshot
DEFAULT_WIDTH=800
DEFAULT_HEIGHT=1100
DEFAULT_FORMAT=png
DEFAULT_QUALITY=90

# Security (API Key Authentication)
API_KEY_ENABLED=true
API_KEYS=your-secret-api-key-min-32-chars-long-here,another-key-if-needed
