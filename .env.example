# Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO

# Puppeteer
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=30000

# Tiles del mapa (opcional)
# Default: OpenStreetMap oficial, sin API key.
# CARTO gratuito NO sirve: estampa "API KEY REQUIRED" sobre el mapa.
# TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?api_key=TU_KEY
# TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
# TILE_SUBDOMAINS=abcd

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Defaults
DEFAULT_GRID_SIZE=9
DEFAULT_RADIUS_KM=4.0
DEFAULT_MARKER_SIZE=28
DEFAULT_BRAND_TEXT=EquipoSEO

# Screenshot
DEFAULT_WIDTH=800
DEFAULT_HEIGHT=1100
DEFAULT_FORMAT=png
DEFAULT_QUALITY=90

# Security (API Key Authentication)
API_KEY_ENABLED=true
API_KEYS=your-secret-api-key-min-32-chars-long-here,another-key-if-needed
