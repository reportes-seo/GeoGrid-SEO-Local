{
  "name": "geogrid-server",
  "version": "1.2.0",
  "description": "Microservicio para generar informes visuales de posicionamiento SEO local en formato geo-grid",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.js\"",
    "test": "node --test \"test/**/*.test.js\"",
    "test:watch": "node --test --watch \"test/**/*.test.js\""
  },
  "keywords": [
    "seo",
    "local-seo",
    "geogrid",
    "rankings",
    "puppeteer",
    "screenshots"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "puppeteer": "^25.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.0"
  }
}
